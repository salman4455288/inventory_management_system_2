<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/loginPage"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#E8F0F8"
    android:padding="0dp">


    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Logo/Profile Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logo_profile_card"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#D4A574">

            <ImageView
                android:id="@+id/iv_profile_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="App Logo or Profile Picture" />

        </androidx.cardview.widget.CardView>

        <!-- App Title (Shared) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RetailPOS"
            android:textSize="28sp"
            android:textColor="#1C3A47"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp" />

        <!-- Subtitle (Shared) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Inventory &amp; POS System"
            android:textSize="13sp"
            android:textColor="#7A8A99"
            android:layout_marginBottom="30dp" />

        <!-- ================= LOGIN CARD ================= -->
        <LinearLayout
            android:id="@+id/card_login_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="25dp"
            android:elevation="6dp"
            android:visibility="gone">

            <!-- Tab Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:background="@drawable/tab_container_background"
                android:elevation="2dp"
                android:layout_marginBottom="25dp">

                <Button
                    android:id="@+id/tab_login_active"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Login"
                    android:textColor="#1C3A47"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/white"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/tab_signup_inactive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Sign Up"
                    android:textColor="#7A8A99"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#ECECF0"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email or Phone"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/login_email_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/email_phno_hint"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:textColorHint="#A5B3BE"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="18dp"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/login_password_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/password_hint"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:textColorHint="#A5B3BE"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="25dp"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_action_signin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sign In"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/signin_button_background"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textSize="13sp"
                android:textColor="#5B7A91"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>


        <!-- ================= SIGNUP CARD ================= -->
        <LinearLayout
            android:id="@+id/card_signup_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="10dp"
            android:visibility="visible">

            <!-- Tab Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:elevation="2dp"
                android:background="@drawable/tab_container_background"
                android:layout_marginBottom="25dp">

                <Button
                    android:id="@+id/tab_login_inactive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Login"
                    android:textColor="#7A8A99"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#ECECF0"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/tab_signup_active"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Sign Up"
                    android:textColor="#1C3A47"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/white"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/signup_fullname_input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:hint="@string/fullName_hint"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="10dp"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Business Name"
                android:textColor="#1C3A47"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/signup_business_input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:hint="@string/businessName_hint"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="15dp"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/signup_phone_input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:hint="@string/phno_hiny"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="10dp"
                android:inputType="phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/signup_email_input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:hint="@string/email_hint"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="10dp"
                android:inputType="textEmailAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="12sp"
                android:textColor="#1C3A47"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/signup_password_input"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:hint="@string/create_a_password_hint"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/input_field_background"
                android:layout_marginBottom="12dp"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_action_create_account"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Create Account"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/signin_button_background"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>